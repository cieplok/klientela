# Copy to `.env` and adjust before running.
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/klientela.db
NODE_ENV=development
# Used for display and reminder scheduling when no salon timezone is stored yet.
SALON_TZ=Europe/Warsaw
# Allowed CORS origin for the web app in dev.
WEB_ORIGIN=http://localhost:5173
# Seed credentials (change for anything real).
ADMIN_EMAIL=admin@salon.local
ADMIN_PASSWORD=change-me
